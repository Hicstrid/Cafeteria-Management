<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#176B45"
        android:title="Order Reports"
        android:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MANAGER REPORTS"
                android:textColor="#176B45"
                android:textSize="23sp"
                android:textStyle="bold"
                android:paddingBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overview of all cafeteria orders"
                android:textColor="#777777"
                android:textSize="14sp"
                android:paddingBottom="15dp"/>

            <!-- Summary -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="18dp"
                android:elevation="3dp">

                <TextView
                    android:id="@+id/tvTotalOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Orders: 0"
                    android:textColor="#176B45"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="5dp"/>

                <TextView
                    android:id="@+id/tvTotalRevenue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Revenue: R0.00"
                    android:textColor="#176B45"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="5dp"/>

                <TextView
                    android:id="@+id/tvPendingOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pending Orders: 0"
                    android:textColor="#B8860B"
                    android:textSize="16sp"
                    android:padding="5dp"/>

                <TextView
                    android:id="@+id/tvCompletedOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Completed Orders: 0"
                    android:textColor="#176B45"
                    android:textSize="16sp"
                    android:padding="5dp"/>

            </LinearLayout>

            <!-- Category Reports -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SALES BY CATEGORY"
                android:textColor="#176B45"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/categoryReportsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Individual Order Reports -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALL CUSTOMER ORDERS"
                android:textColor="#176B45"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/reportsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
